<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <!-- Period Date Navigation -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPrevPeriod"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="&lt;"
                android:textColor="@color/focus_text_dark"
                app:strokeColor="@color/focus_border_green" />

            <TextView
                android:id="@+id/tvReportSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/focus_text_dark"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="September 2026" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNextPeriod"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="&gt;"
                android:textColor="@color/focus_text_dark"
                app:strokeColor="@color/focus_border_green" />
        </LinearLayout>

        <!-- Card 1: Metrics Summary Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_rounded_card"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Avatar + Headline Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="Calm stone"
                    android:src="@drawable/ic_trace_calm_stone" />

                <TextView
                    android:id="@+id/tvSummaryHeadline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="You stayed focused across 52 sessions this month."
                    android:textColor="@color/focus_text_dark"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 2x2 Grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTotalFocusValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="30h 20m"
                        android:textColor="@color/focus_text_dark"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total focus time"
                        android:textColor="@color/focus_text_dark"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvChecksPerHourValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4.6"
                        android:textColor="@color/focus_text_dark"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Checks per focus hour"
                        android:textColor="@color/focus_text_dark"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="12dp"
                android:background="@color/focus_divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvCompletionRateValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="85%"
                        android:textColor="@color/focus_text_dark"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Goal completion rate"
                        android:textColor="@color/focus_text_dark"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvLongestFocusValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="60 min"
                        android:textColor="@color/focus_text_dark"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Longest focus period"
                        android:textColor="@color/focus_text_dark"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvSummaryFooter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="52 sessions · 44 targets completed · 129 checks"
                android:textColor="@color/focus_text_dark"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Card 2: Focus time by week Card -->
        <LinearLayout
            android:id="@+id/cardChartContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_rounded_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvChartTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Focus time by week"
                android:textColor="@color/focus_text_dark"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvChartSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="1,820 minutes focused across the month"
                android:textColor="@color/focus_text_dark"
                android:textSize="12sp" />

            <com.github.mikephil.charting.charts.BarChart
                android:id="@+id/barChartFocusByDay"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="12dp" />
        </LinearLayout>

        <!-- Card 3: What pulled you away Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_rounded_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="What pulled you away"
                android:textColor="@color/focus_text_dark"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="During focus sessions · allowed apps excluded"
                android:textColor="@color/focus_text_dark"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/layoutAppUsagesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- Card 4: Early Stop reasons Card -->
        <LinearLayout
            android:id="@+id/cardEarlyStops"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_rounded_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Early Stop reasons"
                android:textColor="@color/focus_text_dark"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEarlyStopsSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="8 early stops this month"
                android:textColor="@color/focus_text_dark"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvEarlyStopReasonsDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Finished early 3 · Lost focus 3 · Urgent task 2"
                android:textColor="@color/focus_text_dark"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Footer Encouragement Text -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="Patterns help you improve, not judge your day. Explore your Focus Insight for a practical next step."
            android:textColor="@color/focus_text_dark"
            android:textSize="12sp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
