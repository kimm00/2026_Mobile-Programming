<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/report_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/focus_bg_light"
    android:orientation="vertical"
    tools:context=".ui.ReportActivity">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Focus Report"
            android:textColor="@color/focus_text_dark"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/btn_ai_insight_report"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_status_badge"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Sparkles"
                android:src="@drawable/ic_sparkles"
                app:tint="@color/focus_text_dark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="AI Insight"
                android:textColor="@color/focus_text_dark"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- View Mode Toggle: Overview vs Calendar -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayoutViewMode"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginHorizontal="20dp"
        android:background="@drawable/bg_rounded_card_white"
        app:tabIndicatorColor="@color/focus_brand_green"
        app:tabSelectedTextColor="@color/focus_text_dark"
        app:tabTextColor="@color/focus_text_secondary">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Overview" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Calendar" />
    </com.google.android.material.tabs.TabLayout>

    <!-- Main Container for Overview vs Calendar View Mode -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- OVERVIEW CONTAINER -->
        <LinearLayout
            android:id="@+id/layout_overview_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Period Tabs (Day / Week / Month) -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayoutPeriod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="8dp"
                app:tabIndicatorColor="@color/focus_brand_green"
                app:tabSelectedTextColor="@color/focus_text_dark"
                app:tabTextColor="@color/focus_text_secondary" />

            <!-- ViewPager2 for Day, Week, Month Fragments -->
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPagerReport"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- CALENDAR CONTAINER -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/layout_calendar_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="12dp"
                android:paddingBottom="24dp">

                <!-- Calendar Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_rounded_card_white"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Month Navigation -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_prev_month"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:text="&lt;"
                            android:textColor="@color/focus_text_dark"
                            app:strokeColor="@color/focus_border_green" />

                        <TextView
                            android:id="@+id/tv_month_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="November 2026"
                            android:textColor="@color/focus_text_dark"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_next_month"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:text="&gt;"
                            android:textColor="@color/focus_text_dark"
                            app:strokeColor="@color/focus_border_green" />
                    </LinearLayout>

                    <!-- Calendar View -->
                    <CalendarView
                        android:id="@+id/calendar_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" />

                </LinearLayout>

                <!-- Selected Day Session List Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_rounded_card_white"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_selected_day_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Selected Day Sessions"
                        android:textColor="@color/focus_text_dark"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_selected_day_header_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/focus_text_dark"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="Total: 2 session(s) · 1h 20m focus · 3 phone check(s)" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_calendar_sessions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:nestedScrollingEnabled="false"
                        tools:listitem="@layout/item_calendar_session" />

                    <TextView
                        android:id="@+id/tv_calendar_empty_state"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="No sessions recorded on this day."
                        android:textColor="@color/focus_text_secondary"
                        android:textSize="13sp"
                        android:visibility="gone" />
                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </FrameLayout>

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/focus_surface_white"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Home Tab -->
        <LinearLayout
            android:id="@+id/btn_nav_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Home"
                android:src="@drawable/ic_home"
                app:tint="@color/focus_text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Home"
                android:textColor="@color/focus_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Report Tab -->
        <LinearLayout
            android:id="@+id/btn_nav_report"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Report"
                android:src="@drawable/ic_chart"
                app:tint="@color/focus_text_dark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Report"
                android:textColor="@color/focus_text_dark"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Journal Tab -->
        <LinearLayout
            android:id="@+id/btn_nav_journal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Journal"
                android:src="@drawable/ic_journal"
                app:tint="@color/focus_text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Journal"
                android:textColor="@color/focus_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
