<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/focus_gray_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Focus Report"
            android:textColor="@color/focus_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Day / Week / Month -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayoutPeriod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:tabIndicatorColor="@color/focus_green_primary"
            app:tabSelectedTextColor="@color/focus_text_primary"
            app:tabTextColor="@color/focus_text_secondary">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Day" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Week" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Month" />
        </com.google.android.material.tabs.TabLayout>

        <!-- Date Navigation -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPrevPeriod"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="&lt;"
                android:textColor="@color/focus_text_primary"
                app:backgroundTint="@color/focus_green_light" />

            <TextView
                android:id="@+id/tvReportSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/focus_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Nov 2, 2026 – Nov 8, 2026" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNextPeriod"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="&gt;"
                android:textColor="@color/focus_text_primary"
                app:backgroundTint="@color/focus_green_light" />
        </LinearLayout>

        <!-- Summary Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/focus_card_bg"
                app:cardCornerRadius="12dp"
                app:strokeColor="@color/focus_green_light"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Total Focus"
                        android:textColor="@color/focus_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvTotalFocusValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/focus_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="1h 25m" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/focus_card_bg"
                app:cardCornerRadius="12dp"
                app:strokeColor="@color/focus_green_light"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Checks / Hour"
                        android:textColor="@color/focus_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvChecksPerHourValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/focus_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="3.53 / hr" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Summary Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/focus_card_bg"
                app:cardCornerRadius="12dp"
                app:strokeColor="@color/focus_green_light"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Goal Completion"
                        android:textColor="@color/focus_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvCompletionRateValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/focus_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="75.0%" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/focus_card_bg"
                app:cardCornerRadius="12dp"
                app:strokeColor="@color/focus_green_light"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Longest Focus"
                        android:textColor="@color/focus_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvLongestFocusValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/focus_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="40 min" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- NEW: Phone Metrics -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/focus_card_bg"
                app:cardCornerRadius="12dp"
                app:strokeColor="@color/focus_green_light"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Phone Checks"
                        android:textColor="@color/focus_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvPhoneChecksValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/focus_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="5 times" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/focus_card_bg"
                app:cardCornerRadius="12dp"
                app:strokeColor="@color/focus_green_light"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Phone Usage"
                        android:textColor="@color/focus_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvPhoneUsageValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/focus_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="12 min" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- NEW: Most Used Apps -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/focus_card_bg"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/focus_green_light"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Most Used Apps"
                    android:textColor="@color/focus_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMostUsedAppsContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="6dp"
                    android:text="No app usage recorded"
                    android:textColor="@color/focus_text_secondary"
                    android:textSize="14sp"
                    tools:text="Instagram: 7 min&#10;YouTube: 5 min" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Day Focus Timeline -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDayTimeline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/focus_card_bg"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/focus_green_light"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Focus Timeline"
                    android:textColor="@color/focus_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDayTimelineContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/focus_text_primary"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Week / Month Chart -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardChartContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/focus_card_bg"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/focus_green_light"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvChartTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Focus time by day"
                    android:textColor="@color/focus_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvChartSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Daily total focus minutes"
                    android:textColor="@color/focus_text_secondary"
                    android:textSize="12sp" />

                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/barChartFocusByDay"
                    android:layout_width="match_parent"
                    android:layout_height="240dp"
                    android:layout_marginTop="16dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Early Stop Reasons -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/focus_card_bg"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/focus_green_light"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Early Stop Reasons"
                    android:textColor="@color/focus_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEarlyStopReasonsSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/focus_text_secondary"
                    android:textSize="14sp"
                    tools:text="TIRED: 1, INTERRUPTED: 1" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
