<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/earlyStopRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#6645593A"
    tools:context=".ui.EarlyStopActivity">

    <!-- Bottom Sheet Card Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_sheet"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <!-- Handle Bar -->
        <View
            android:layout_width="32dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_status_badge"
            android:backgroundTint="@color/focus_border_green" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <!-- Mascot -->
                <ImageView
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:contentDescription="Distracted Mascot"
                    android:src="@drawable/ic_trace_distracted_stone" />

                <!-- Question Headline -->
                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Why are you ending early?"
                    android:textColor="@color/focus_text_dark"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="A quick check-in helps spot your patterns."
                    android:textColor="@color/focus_text_dark"
                    android:textSize="14sp" />

                <!-- Stop Reasons RadioGroup -->
                <RadioGroup
                    android:id="@+id/rgReasons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">

                    <RadioButton
                        android:id="@+id/rbTaskCompleted"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:buttonTint="@color/focus_brand_green"
                        android:paddingStart="8dp"
                        android:text="Finished early"
                        android:textColor="@color/focus_text_dark"
                        android:textSize="16sp" />

                    <RadioButton
                        android:id="@+id/rbDistracted"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:buttonTint="@color/focus_brand_green"
                        android:checked="true"
                        android:paddingStart="8dp"
                        android:text="Lost focus"
                        android:textColor="@color/focus_text_dark"
                        android:textSize="16sp" />

                    <RadioButton
                        android:id="@+id/rbInterrupted"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:buttonTint="@color/focus_brand_green"
                        android:paddingStart="8dp"
                        android:text="Urgent task"
                        android:textColor="@color/focus_text_dark"
                        android:textSize="16sp" />

                    <RadioButton
                        android:id="@+id/rbTired"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:buttonTint="@color/focus_brand_green"
                        android:paddingStart="8dp"
                        android:text="Schedule changed"
                        android:textColor="@color/focus_text_dark"
                        android:textSize="16sp" />

                    <RadioButton
                        android:id="@+id/rbOther"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:buttonTint="@color/focus_brand_green"
                        android:paddingStart="8dp"
                        android:text="Other"
                        android:textColor="@color/focus_text_dark"
                        android:textSize="16sp" />

                </RadioGroup>

                <!-- Optional Note Group -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Optional note"
                        android:textColor="@color/focus_text_dark"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilNote"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        app:boxBackgroundColor="@color/focus_surface_white"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="@color/focus_border_green"
                        app:counterEnabled="true"
                        app:counterMaxLength="300">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etNote"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Add a note"
                            android:inputType="textMultiLine"
                            android:maxLength="300"
                            android:maxLines="3"
                            android:textColor="@color/focus_text_dark"
                            android:textSize="15sp" />

                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- Action Buttons -->
                <LinearLayout
                    android:id="@+id/btnContinueSession"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_button_primary"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Continue Session"
                        android:textColor="@color/focus_text_dark"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnSave"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_button_end_session"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="End Session"
                        android:textColor="@color/focus_text_dark"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

</FrameLayout>
